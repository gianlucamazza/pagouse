{
  "manifest_version": 3,
  "name": "pagouse",
  "version": "0.2.0",
  "description": "Page agent for coding agents. By ref, not by pixel.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "pagouse",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/pagouse-16.png",
      "32": "icons/pagouse-32.png"
    }
  },
  "icons": {
    "16": "icons/pagouse-16.png",
    "32": "icons/pagouse-32.png",
    "48": "icons/pagouse-48.png",
    "128": "icons/pagouse-128.png"
  }
}
